MONGO_URI=your_mongodb_connection_string
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secret_here
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
FRONTEND_URL=http://localhost:5173
# Practical 13 — AI description generator. BACKEND ONLY: never prefix a key
# with VITE_ and never commit a real value. Leave the key empty to run with
# graceful fallback (no provider call is attempted, the UI offers the manual
# path). Optional model overrides default to the values in
# src/services/aiDescriptionService.js.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
JOB_PAYLOAD_ENCRYPTION_KEY=YOUR_GENERATED_64_CHARACTER_KEY
# Optional: ISOLATED database for integration tests ONLY (never the app DB).
# The database name MUST end in _test or integration tests refuse to run.
# TEST_MONGO_URI=mongodb://localhost:27017/task_manager_test
# RUN_INTEGRATION_TESTS=1
